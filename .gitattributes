# Normalize line endings and mark binary files
* text=auto

# Windows scripting
*.ps1 text eol=crlf

# Code — keep LF for consistency across contributors
*.rs    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Binary files — never touch
*.png  binary
*.ico  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.msi  binary
*.exe  binary
*.woff binary
*.woff2 binary

# Linguist overrides — these are generated/borrowed, don't skew repo stats
src-tauri/gen/ linguist-generated=true
package-lock.json linguist-generated=true
src-tauri/Cargo.lock linguist-generated=true
